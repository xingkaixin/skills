{
  "name": "skills",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm generate:web-data && pnpm --filter web dev",
    "build": "pnpm generate:web-data && pnpm --filter web build",
    "preview": "pnpm --filter web preview",
    "lint": "pnpm check:generated && pnpm --filter web lint",
    "test": "node --test tests/*.test.ts && python3 -m unittest discover -s tests -p 'test_*.py'",
    "typecheck": "pnpm exec tsc -p tsconfig.json && pnpm --filter web typecheck",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "check:generated": "node scripts/generate-web-skills.ts --check",
    "deploy:cf": "pnpm --filter web deploy:cf",
    "generate:web-data": "node scripts/generate-web-skills.ts"
  },
  "packageManager": "pnpm@11.14.0",
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/sanitize-html": "^2.16.1",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "marked": "^18.0.7",
    "sanitize-html": "^2.17.6",
    "typescript": "^6.0.3"
  }
}
