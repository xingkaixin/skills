---
import { Image } from "astro:assets";
import openFolio from "@/assets/backgrounds/open-folio.png";
import BaseLayout from "@/layouts/BaseLayout.astro";
import CopyCommand from "@/components/CopyCommand.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SkillProse from "@/components/SkillProse.astro";
import SkillToc from "@/components/SkillToc.astro";
import { getSkillSeo } from "@/data/seo";
import { getInstallCommand } from "@/data/skill-catalog";
import { skillContent } from "@/data/skills.content.generated";
import { skillsData } from "@/data/skills.generated";
import { extractToc } from "@/data/skill-toc";
import { formatRepoLabel, type SkillRecord } from "@/data/skill-record";
import { DEFAULT_LOCALE, LOCALES, localeHref, localeTags, type Locale } from "@/i18n/config";
import { ui } from "@/i18n/ui";

export function getStaticPaths() {
  return LOCALES.flatMap((locale) =>
    skillsData.map((skill) => ({
      params: {
        locale: locale === DEFAULT_LOCALE ? undefined : locale,
        slug: skill.slug,
      },
      props: { skill, locale },
    })),
  );
}

const { skill, locale } = Astro.props as { skill: SkillRecord; locale: Locale };
const strings = ui[locale];
const seo = getSkillSeo(skill, locale);
const path = `/skills/${skill.slug}`;
const body = skillContent[skill.slug];
const installCommand = getInstallCommand(skillsData, "skill", skill.slug);
const toc = extractToc(body);
const categoryHref = `${localeHref(locale)}?category=${encodeURIComponent(skill.category)}`;
const related = skillsData
  .filter((item) => item.category === skill.category && item.slug !== skill.slug)
  .slice(0, 3);
const meta = [
  { label: strings.skill.added, value: skill.firstAdded },
  { label: strings.skill.updated, value: skill.lastModified },
  { label: strings.skill.source, value: skill.sourceKind },
];
// The body stays in whatever language it was written in; say so when that is
// not the language the reader picked.
const bodyLanguageNote =
  localeTags[locale] === skill.contentLanguage
    ? null
    : skill.contentLanguage === "zh-CN"
      ? strings.skill.writtenInChinese
      : strings.skill.writtenInEnglish;
---

<BaseLayout
  locale={locale}
  path={path}
  title={seo.title}
  description={seo.description}
  ogType={seo.ogType}
  structuredData={seo.structuredData}
>
  <SiteHeader variant="detail" locale={locale} path={path} />

  <div class="border-b border-divider px-6 py-2.5 sm:px-10">
    <nav aria-label="Breadcrumb" class="mx-auto max-w-6xl font-mono text-[11.5px] text-text-muted">
      <a href={localeHref(locale)} class="transition hover:text-text">
        {strings.skill.breadcrumbRoot}
      </a>
      <span class="mx-1.5">/</span>
      <a href={categoryHref} class="transition hover:text-text">{skill.category}</a>
      <span class="mx-1.5">/</span>
      <span class="text-text">{skill.slug}</span>
    </nav>
  </div>

  <main id="main-content" class="relative px-6 sm:px-10">
    <Image
      src={openFolio}
      alt=""
      aria-hidden="true"
      class="detail-art"
      widths={[640, 960, 1440, openFolio.width]}
      sizes="100vw"
      format="webp"
      quality={75}
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="relative mx-auto grid max-w-6xl items-start gap-12 pt-11 pb-14 lg:grid-cols-[minmax(0,1fr)_240px] lg:gap-14">
      <div class="min-w-0">
        <a href={categoryHref} class="category-pill pressable">{skill.category}</a>
        <h1 class="mt-4 font-mono text-[1.75rem] leading-tight font-medium break-words text-text sm:text-[2rem]">
          {skill.slug}
        </h1>
        <p class="mt-4.5 max-w-[64ch] text-[15px] leading-7 text-text-secondary text-pretty">
          {skill.displayDescription[locale]}
        </p>

        <CopyCommand
          command={installCommand}
          locale={locale}
          tone="solid"
          class="mt-6.5 max-w-[42.5rem]"
        />

        <dl class="meta-grid mt-5.5 max-w-[42.5rem]">
          {meta.map((item) => (
            <div>
              <dt class="eyebrow text-[9.5px] text-text-muted">{item.label}</dt>
              <dd class="mt-1.5 font-mono text-[13px] text-text">{item.value}</dd>
            </div>
          ))}
          <div>
            <dt class="eyebrow text-[9.5px] text-text-muted">{strings.skill.repository}</dt>
            <dd class="mt-1.5">
              <a href={skill.sourceRepo} class="font-mono text-[13px] text-accent hover:underline">
                {formatRepoLabel(skill.sourceRepo)}
              </a>
            </dd>
          </div>
        </dl>

        {body && (
          <div class="mt-8 border-t border-divider pt-4 lg:mt-11 lg:pt-9">
            <div class="mb-5 lg:hidden">
              <SkillToc entries={toc} locale={locale} collapsible />
            </div>
            {bodyLanguageNote && (
              <p class="mb-7 text-[12.5px] text-text-muted">{bodyLanguageNote}</p>
            )}
            <div lang={skill.contentLanguage}>
              <SkillProse html={body} locale={locale} />
            </div>
          </div>
        )}
      </div>

      <aside class="flex flex-col gap-5.5 lg:sticky lg:top-6">
        <div class="hidden lg:block">
          <SkillToc entries={toc} locale={locale} />
        </div>

        {related.length > 0 && (
          <div class="border-t border-divider pt-5">
            <p class="eyebrow mb-3 tracking-[0.18em] text-text-muted">
              {strings.skill.moreIn(skill.category)}
            </p>
            <div class="flex flex-col gap-2">
              {related.map((item) => (
                <a
                  href={localeHref(locale, `/skills/${item.slug}`)}
                  class="flex flex-col gap-1.5 rounded-lg border border-border p-3 transition hover:border-text hover:bg-surface"
                >
                  <span class="font-mono text-[11.5px] break-words text-text">{item.slug}</span>
                  <span class="line-clamp-2 text-[11.5px] leading-5 text-text-muted">
                    {item.displayDescription[locale]}
                  </span>
                </a>
              ))}
            </div>
          </div>
        )}
      </aside>
    </div>
  </main>
</BaseLayout>

<style>
  .detail-art {
    position: absolute;
    inset: 0 0 auto;
    width: 100%;
    height: 24rem;
    object-fit: cover;
    object-position: right bottom;
    opacity: 0.4;
    mask-image: linear-gradient(#000, transparent);
    pointer-events: none;
    user-select: none;
  }

  @media (max-width: 639px) {
    .detail-art {
      opacity: 0.2;
    }
  }
</style>
