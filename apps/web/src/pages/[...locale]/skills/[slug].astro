---
import arrowRight from "@phosphor-icons/core/regular/arrow-right.svg?no-inline";
import info from "@phosphor-icons/core/regular/info.svg?no-inline";
import BaseLayout from "@/layouts/BaseLayout.astro";
import CopyCommand from "@/components/CopyCommand.astro";
import PhosphorIcon from "@/components/PhosphorIcon.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SkillProse from "@/components/SkillProse.astro";
import SkillToc from "@/components/SkillToc.astro";
import { relatedSkills } from "@/data/related-skills";
import { getSkillSeo } from "@/data/seo";
import { categoryMetadata } from "@/data/catalog";
import { skillTitles } from "@/data/skill-titles";
import { getInstallCommand } from "@/data/skill-catalog";
import { skillContent } from "@/data/skills.content.generated";
import { skillsData } from "@/data/skills.generated";
import { extractToc } from "@/data/skill-toc";
import { formatRepoLabel, type SkillRecord } from "@/data/skill-record";
import { DEFAULT_LOCALE, LOCALES, localeHref, localeTags, type Locale } from "@/i18n/config";
import { ui } from "@/i18n/ui";

export function getStaticPaths() {
  return LOCALES.flatMap((locale) =>
    skillsData.map((skill) => ({
      params: {
        locale: locale === DEFAULT_LOCALE ? undefined : locale,
        slug: skill.slug,
      },
      props: { skill, locale },
    })),
  );
}

const { skill, locale } = Astro.props as { skill: SkillRecord; locale: Locale };
const strings = ui[locale];
const seo = getSkillSeo(skill, locale);
const path = `/skills/${skill.slug}`;
const body = skillContent[skill.slug];
const installCommand = getInstallCommand(skillsData, "skill", skill.slug);
const toc = extractToc(body);
const categoryHref = localeHref(locale, `/categories/${skill.category}`);
const curated = relatedSkills[skill.slug];
const related = curated
  ? curated.map((link) => {
      const item = skillsData.find((candidate) => candidate.slug === link.slug);
      if (!item) throw new Error(`Unknown related skill: ${link.slug}`);
      return { ...item, reason: link.reason[locale] };
    })
  : skillsData
      .filter((item) => item.category === skill.category && item.slug !== skill.slug)
      .slice(0, 3)
      .map((item) => ({ ...item, reason: item.displayDescription[locale] }));
const meta = [
  { label: strings.skill.added, value: skill.firstAdded },
  { label: strings.skill.updated, value: skill.lastModified },
  { label: strings.skill.writtenIn, value: strings.skill.languages[skill.contentLanguage] },
];
// The body stays in whatever language it was written in; say so when that is
// not the language the reader picked.
const bodyLanguageNote =
  localeTags[locale] === skill.contentLanguage
    ? null
    : skill.contentLanguage === "zh-CN"
      ? strings.skill.writtenInChinese
      : strings.skill.writtenInEnglish;
---

<BaseLayout
  locale={locale}
  path={path}
  title={seo.title}
  description={seo.description}
  ogType={seo.ogType}
  structuredData={seo.structuredData}
>
  <SiteHeader variant="detail" locale={locale} path={path} />

  <main id="main-content" class="px-6 sm:px-10">
    <nav aria-label="Breadcrumb" class="mx-auto max-w-6xl pt-7 text-[13px] text-text-muted">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a href={localeHref(locale)} class="transition-colors hover:text-text">{strings.skill.breadcrumbRoot}</a></li>
        <li aria-hidden="true">/</li>
        <li><a href={categoryHref} class="transition-colors hover:text-text">{categoryMetadata[skill.category].webTitle[locale]}</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="font-mono break-all text-text">{skill.slug}</li>
      </ol>
    </nav>

    <div class="mx-auto grid max-w-6xl items-start gap-12 pt-8 pb-16 lg:grid-cols-[minmax(0,1fr)_260px] lg:gap-14">
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-2">
          <a href={categoryHref} class="category-pill pressable">{skill.category}</a>
          <span class="rounded-full bg-fill px-2.5 py-1 text-xs text-text-secondary">{strings.catalog.sourceKinds[skill.sourceKind]}</span>
        </div>
        <h1 class="mt-4 text-[2rem] leading-[1.1] font-semibold tracking-[-0.03em] text-balance text-text sm:text-[2.75rem]">
          {skillTitles[skill.slug]?.[locale] ?? skill.slug}
        </h1>
        <p class="mt-2.5 font-mono text-sm break-words text-text-muted">{skill.slug}</p>
        <p class="mt-5 max-w-[60ch] text-[17px] leading-[1.7] text-pretty text-text-secondary">
          {skill.displayDescription[locale]}
        </p>

        <section aria-labelledby="install-heading" class="mt-8 max-w-[45rem] overflow-hidden rounded-2xl border border-border">
          <div class="flex flex-wrap items-baseline justify-between gap-2 px-4.5 pt-4">
            <h2 id="install-heading" class="text-sm font-semibold text-text">{strings.skill.install}</h2>
            <span class="text-xs text-text-muted">Claude Code · Codex</span>
          </div>
          <CopyCommand command={installCommand} locale={locale} skill={skill.slug} class="mx-4.5 mt-3" />
          <dl class="meta-grid mt-4">
            {meta.map((item) => (
              <div>
                <dt class="text-xs text-text-muted">{item.label}</dt>
                <dd class="mt-1 text-sm text-text">{item.value}</dd>
              </div>
            ))}
            <div>
              <dt class="text-xs text-text-muted">{strings.skill.repository}</dt>
              <dd class="mt-1 text-sm">
                <a href={skill.sourceRepo} class="break-all text-accent hover:underline">
                  {formatRepoLabel(skill.sourceRepo)}
                </a>
              </dd>
            </div>
          </dl>
        </section>

        {bodyLanguageNote && (
          <p class="mt-5 flex max-w-[45rem] items-start gap-2.5 rounded-xl bg-surface px-4 py-3.5 text-sm leading-6 text-text-secondary">
            <PhosphorIcon src={info} class="mt-1 h-4 w-4 text-accent" />
            {bodyLanguageNote}
          </p>
        )}

        {body && (
          <div class="mt-8 border-t border-divider pt-4 lg:mt-10 lg:pt-8">
            <div class="mb-5 lg:hidden">
              <SkillToc entries={toc} locale={locale} collapsible />
            </div>
            <div lang={skill.contentLanguage}>
              <SkillProse html={body} locale={locale} />
            </div>
          </div>
        )}
      </div>

      <aside class="hidden lg:sticky lg:top-24 lg:block">
        <SkillToc entries={toc} locale={locale} />
      </aside>
    </div>

    {related.length > 0 && (
      <section aria-labelledby="related-heading" class="mx-auto max-w-6xl border-t border-divider pt-14 pb-20">
        <h2 id="related-heading" class="text-xl font-semibold tracking-[-0.02em] text-text sm:text-2xl">
          {curated ? strings.skill.nextSteps : strings.skill.moreIn(skill.category)}
        </h2>
        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((item) => (
            <a href={localeHref(locale, `/skills/${item.slug}`)} class="skill-card">
              <span class="eyebrow text-accent">{item.category}</span>
              <h3 class="text-[17px] leading-snug font-semibold text-text">{skillTitles[item.slug]?.[locale] ?? item.slug}</h3>
              <p class="text-sm leading-6 text-text-secondary">{item.reason}</p>
              <PhosphorIcon src={arrowRight} class="card-arrow mt-auto h-4 w-4 self-end text-text-muted" />
            </a>
          ))}
        </div>
      </section>
    )}
  </main>
</BaseLayout>
