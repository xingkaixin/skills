---
import { Image } from "astro:assets";
import knowledgeModules from "@/assets/backgrounds/knowledge-modules.png";
import openFolio from "@/assets/backgrounds/open-folio.png";
import BaseLayout from "@/layouts/BaseLayout.astro";
import CopyCommand from "@/components/CopyCommand.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SkillCatalog from "@/components/SkillCatalog.astro";
import { getInstallCommand } from "@/data/skill-catalog";
import { skillCategories, skillsData } from "@/data/skills.generated";
import { getHomeSeo } from "@/data/seo";
import { DEFAULT_LOCALE, LOCALES, type Locale } from "@/i18n/config";
import { ui } from "@/i18n/ui";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({
    // The default locale owns the bare "/" path, so its segment stays empty.
    params: { locale: locale === DEFAULT_LOCALE ? undefined : locale },
    props: { locale },
  }));
}

const { locale } = Astro.props as { locale: Locale };
const seo = getHomeSeo(locale);
const strings = ui[locale];
const installCommand = getInstallCommand(skillsData, "all");
---

<BaseLayout
  locale={locale}
  path="/"
  title={seo.title}
  description={seo.description}
  ogType={seo.ogType}
  structuredData={seo.structuredData}
>
  <SiteHeader variant="home" locale={locale} path="/" />

  <main id="main-content">
    <section class="home-hero border-b border-divider px-6 pt-14 pb-10 sm:px-10">
      <Image
        src={knowledgeModules}
        alt=""
        aria-hidden="true"
        class="section-art hero-art"
        widths={[640, 960, 1440, knowledgeModules.width]}
        sizes="100vw"
        format="webp"
        quality={80}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <div class="relative mx-auto grid max-w-6xl grid-cols-1 gap-10 lg:grid-cols-[1.15fr_1fr] lg:items-end">
        <div>
          <p class="eyebrow text-accent">{strings.home.eyebrow}</p>
          <h1
            class:list={[
              "mt-3.5 text-[2.25rem] leading-[1.12] font-semibold tracking-[-0.02em] text-balance sm:text-[2.75rem]",
              // A `ch` is the width of "0", so a full-width character spends
              // two of them; CJK headings need the wider measure to
              // break across the same number of lines.
              locale === "en" ? "max-w-[15ch]" : "max-w-[24ch]",
            ]}
          >
            {strings.home.heading.split(/(Agent Skills)/).map((part) => (
              <span class:list={[part === "Agent Skills" && "whitespace-nowrap"]}>{part}</span>
            ))}
          </h1>
          <p class="mt-4.5 max-w-[46ch] text-[15px] leading-7 text-text-secondary">
            {strings.home.intro(skillsData.length)}
          </p>
        </div>
        <div class="flex flex-col gap-3">
          <p class="text-xs text-text-secondary">{strings.home.installAll}</p>
          <CopyCommand command={installCommand} locale={locale} />
          <p class="font-mono text-xs text-text-muted">
            {strings.home.installOne} <span class="text-text-secondary">--skill &lt;slug&gt;</span>
          </p>
        </div>
      </div>
    </section>

    <div class="home-catalog">
      <SkillCatalog skills={skillsData} categories={skillCategories} locale={locale} />
    </div>

    <section id="faq" aria-labelledby="faq-heading" class="home-faq px-6 pt-16 pb-20 sm:px-10">
      <Image
        src={openFolio}
        alt=""
        aria-hidden="true"
        class="section-art faq-art"
        widths={[640, 960, 1440, openFolio.width]}
        sizes="100vw"
        format="webp"
        quality={75}
        loading="lazy"
        decoding="async"
      />
      <div class="relative mx-auto max-w-6xl border-t border-divider pt-12">
        <h2 id="faq-heading" class="text-lg font-semibold text-text">{strings.home.faqHeading}</h2>
        <dl class="mt-6 grid gap-6 sm:grid-cols-2">
          {strings.faq.map((item) => (
            <div>
              <dt class="text-sm font-medium text-text">{item.question}</dt>
              <dd class="mt-1.5 text-sm leading-7 text-text-secondary">{item.answer}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .home-hero,
  .home-faq {
    position: relative;
  }

  .home-hero {
    background: #f4f7fb;
  }

  .section-art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
    user-select: none;
  }

  .hero-art {
    object-position: center top;
    opacity: 0.8;
    mask-image: linear-gradient(#000 25%, transparent 100%);
  }

  .home-catalog {
    background: linear-gradient(#ffffff 8rem, #f5f7fa 32rem);
  }

  .home-faq {
    background: linear-gradient(#f5f7fa, #f0f4f9);
  }

  .faq-art {
    opacity: 0.55;
    object-position: right bottom;
    mask-image: linear-gradient(transparent, #000 65%);
  }

  @media (max-width: 1023px) {
    .hero-art {
      object-position: 62% top;
      opacity: 0.42;
    }
  }

  @media (max-width: 639px) {
    .hero-art {
      object-position: 58% top;
      opacity: 0.25;
    }

    .faq-art {
      opacity: 0.3;
    }
  }
</style>
