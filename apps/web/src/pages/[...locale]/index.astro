---
import chevronDown from "lucide-static/icons/chevron-down.svg?raw";
import BaseLayout from "@/layouts/BaseLayout.astro";
import CopyCommand from "@/components/CopyCommand.astro";
import Divider from "@/components/Divider.astro";
import Icon from "@/components/Icon.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SkillCatalog from "@/components/SkillCatalog.astro";
import { categoryMetadata, SITE_REPO } from "@/data/catalog";
import { getInstallCommand } from "@/data/skill-catalog";
import { extractToc } from "@/data/skill-toc";
import { skillContent } from "@/data/skills.content.generated";
import { skillCategories, skillsData } from "@/data/skills.generated";
import { getHomeSeo } from "@/data/seo";
import { DEFAULT_LOCALE, LOCALES, localeHref, type Locale } from "@/i18n/config";
import { ui } from "@/i18n/ui";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({
    // The default locale owns the bare "/" path, so its segment stays empty.
    params: { locale: locale === DEFAULT_LOCALE ? undefined : locale },
    props: { locale },
  }));
}

// An English skill keeps the example readable on every locale. Rendered
// headings sit one level below the source, so depth 0 is a Markdown "#".
const EXAMPLE_SLUG = "use-modern-go";

const { locale } = Astro.props as { locale: Locale };
const seo = getHomeSeo(locale);
const strings = ui[locale];
const latestUpdate = skillsData.reduce(
  (latest, skill) => (skill.lastModified > latest ? skill.lastModified : latest),
  "",
);
const example = skillsData.find((skill) => skill.slug === EXAMPLE_SLUG);
if (!example) throw new Error(`Unknown example skill: ${EXAMPLE_SLUG}`);
const exampleHeadings = extractToc(skillContent[EXAMPLE_SLUG]).slice(0, 6);
const installPanels = [
  { id: "install-all", label: strings.home.installAll, command: getInstallCommand(skillsData, "all"), skill: undefined },
  { id: "install-one", label: strings.home.installOne, command: getInstallCommand(skillsData, "skill", EXAMPLE_SLUG), skill: EXAMPLE_SLUG },
];
const categoryTiles = skillCategories.map((category) => ({
  category,
  title: categoryMetadata[category].webTitle[locale],
  description: categoryMetadata[category].webDescription[locale],
  count: skillsData.filter((skill) => skill.category === category).length,
}));
const sectionHeading = "text-title text-ink";
const sectionIntro = "mt-2.5 max-w-[60ch] text-body text-ink-muted";
---

<BaseLayout
  locale={locale}
  path="/"
  title={seo.title}
  description={seo.description}
  ogType={seo.ogType}
  structuredData={seo.structuredData}
>
  <SiteHeader variant="home" locale={locale} path="/" />

  <main id="main-content">
    <section aria-labelledby="hero-heading" class="relative px-6 sm:px-10">
      <div class="mx-auto grid max-w-6xl gap-14 py-16 sm:py-20 lg:grid-cols-[1.1fr_1fr] lg:items-center">
        <div class="min-w-0">
          <p class="lm-badge" data-sketch data-radius="999">
            <span class="h-1.5 w-1.5 rounded-full bg-vermilion"></span>
            {strings.home.badge(skillsData.length, latestUpdate)}
          </p>
          <h1
            id="hero-heading"
            class:list={[
              "mt-5 text-display text-balance text-ink sm:text-hero",
              // A `ch` is the width of "0", so a full-width character spends
              // two of them; CJK headings need the wider measure.
              locale === "en" ? "max-w-[15ch]" : "max-w-[22ch]",
            ]}
          >
            {strings.home.heading.split(/(Agent Skills)/).map((part) =>
              part === "Agent Skills" ? (
                <span class="lm-mark whitespace-nowrap" data-sketch="underline">{part}</span>
              ) : (
                <span>{part}</span>
              ),
            )}
          </h1>
          <p class="mt-5 max-w-[52ch] text-subheading text-ink-muted sm:leading-7">
            {strings.home.intro}
          </p>

          <div class="mt-8 max-w-[36rem]" data-install-tabs>
            <div class="seg-group" role="tablist" aria-label={strings.home.installScope}>
              {installPanels.map((panel, index) => (
                <button
                  type="button"
                  role="tab"
                  id={`${panel.id}-tab`}
                  class="seg-button pressable"
                  data-sketch="wash"
                  aria-selected={index === 0 ? "true" : "false"}
                  aria-controls={panel.id}
                >
                  {panel.label}
                </button>
              ))}
            </div>
            {installPanels.map((panel, index) => (
              <div id={panel.id} role="tabpanel" aria-labelledby={`${panel.id}-tab`} class="mt-2.5" hidden={index > 0}>
                <CopyCommand command={panel.command} locale={locale} skill={panel.skill} />
              </div>
            ))}
            <p class="mt-3 text-small text-ink-subtle">{strings.home.installNote}</p>
          </div>
        </div>

        <figure class="lm-card m-0 min-w-0" data-sketch data-radius="8">
          <div class="flex flex-wrap items-center justify-between gap-2 px-5 pt-3.5 pb-2">
            <a href={localeHref(locale, `/skills/${EXAMPLE_SLUG}`)} class="min-w-0 truncate font-mono text-caption text-ink-muted hover:text-ink">
              skills/{example.category}/{EXAMPLE_SLUG}/SKILL.md
            </a>
            <span class="text-small text-ink-subtle">{strings.home.exampleLabel}</span>
          </div>
          <Divider tone="strong" />
          <div class="px-5 pt-4 pb-5 font-mono text-code text-ink" lang="en">
            <span class="block text-ink-subtle">---</span>
            <span class="block"><span class="text-accent">name</span>: {example.name}</span>
            <span class="block"><span class="text-accent">description</span>: {example.description}</span>
            <span class="block text-ink-subtle">---</span>
            <span class="mt-5 block">
              {exampleHeadings.map((heading) => (
                <span class:list={["block", heading.depth === 0 ? "text-ink" : "text-ink-muted"]}>
                  {"#".repeat(heading.depth + 1)} {heading.label}
                </span>
              ))}
            </span>
          </div>
          <Divider />
          <figcaption class="px-5 pt-2 pb-4 text-small text-ink-muted">
            {strings.home.exampleCaption}
          </figcaption>
        </figure>
      </div>
      <Divider class="absolute inset-x-0 bottom-0" />
    </section>

    <section id="categories" aria-labelledby="categories-heading" class="px-6 pt-20 sm:px-10 sm:pt-24">
      <div class="mx-auto max-w-6xl">
        <h2 id="categories-heading" class={sectionHeading}>{strings.home.categoriesHeading}</h2>
        <p class={sectionIntro}>{strings.home.categoriesIntro(skillCategories.length)}</p>
        <ul class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
          {categoryTiles.map((tile) => (
            <li>
              <a
                href={localeHref(locale, `/categories/${tile.category}`)}
                class="lm-card category-tile pressable h-full gap-2 p-4.5"
                data-sketch
                data-radius="8"
              >
                <span class="flex items-baseline justify-between gap-3">
                  <span class="text-subheading text-ink">{tile.title}</span>
                  <span class="shrink-0 text-small text-ink-subtle">{tile.count}</span>
                </span>
                <span class="line-clamp-3 text-small text-ink-muted">{tile.description}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="skills" aria-labelledby="skills-heading" class="px-6 pt-20 pb-24 sm:px-10">
      <div class="mx-auto max-w-6xl">
        <h2 id="skills-heading" class={sectionHeading}>{strings.home.skillsHeading}</h2>
        <p class={sectionIntro}>{strings.home.skillsIntro}</p>
        <div class="mt-5">
          <SkillCatalog skills={skillsData} categories={skillCategories} locale={locale} />
        </div>
      </div>
    </section>

    <section aria-labelledby="how-heading" class="relative bg-surface-muted/60 px-6 py-20 sm:px-10 sm:py-24">
      <Divider class="absolute inset-x-0 top-0" />
      <div class="mx-auto max-w-6xl">
        <h2 id="how-heading" class={sectionHeading}>{strings.home.howHeading}</h2>
        <ol class="mt-9 grid gap-4 md:grid-cols-3">
          {strings.home.steps.map((step, index) => (
            <li class="lm-card p-6" data-sketch data-radius="8">
              <span class="text-small text-accent">{String(index + 1).padStart(2, "0")}</span>
              <h3 class="mt-3 text-subheading text-ink">{step.title}</h3>
              <p class="mt-2 text-body text-ink-muted">{step.body}</p>
            </li>
          ))}
        </ol>
      </div>
      <Divider class="absolute inset-x-0 bottom-0" />
    </section>

    <section id="faq" aria-labelledby="faq-heading" class="px-6 py-20 sm:px-10 sm:py-24">
      <div class="mx-auto flex max-w-6xl flex-wrap gap-12">
        <div class="flex-[1_1_16rem]">
          <h2 id="faq-heading" class={sectionHeading}>{strings.home.faqHeading}</h2>
          <p class={sectionIntro}>
            {strings.home.faqMore}{" "}
            <a href={`${SITE_REPO}/issues`} class="text-accent underline-offset-4 hover:underline">{strings.home.faqIssue}</a>
          </p>
        </div>
        <div class="min-w-0 flex-[999_1_32rem]">
          <Divider />
          {strings.faq.map((item, index) => (
            <>
              <details class="faq-item" open={index === 0}>
                <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 py-4 text-subheading text-ink">
                  {item.question}
                  <Icon svg={chevronDown} class="faq-chevron h-4 w-4 text-ink-subtle" />
                </summary>
                <p class="max-w-[68ch] pb-5 text-body text-ink-muted">{item.answer}</p>
              </details>
              <Divider />
            </>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  const tabs = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-install-tabs] [role=tab]"),
  );

  for (const tab of tabs) {
    tab.addEventListener("click", () => {
      for (const other of tabs) {
        const selected = other === tab;
        other.setAttribute("aria-selected", String(selected));
        document.getElementById(other.getAttribute("aria-controls")!)!.hidden = !selected;
      }
    });
  }
</script>
