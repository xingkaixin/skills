---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SkillCard from "@/components/SkillCard.astro";
import { categoryMetadata } from "@/data/catalog";
import { getCategorySeo } from "@/data/seo";
import { skillCategories, skillsData } from "@/data/skills.generated";
import { DEFAULT_LOCALE, LOCALES, localeHref, type Locale } from "@/i18n/config";
import { ui } from "@/i18n/ui";

export function getStaticPaths() {
  return LOCALES.flatMap((locale) => skillCategories.map((category) => ({
    params: { locale: locale === DEFAULT_LOCALE ? undefined : locale, category },
    props: { locale, category },
  })));
}

const { locale, category } = Astro.props as { locale: Locale; category: string };
const metadata = categoryMetadata[category];
const seo = getCategorySeo(category, locale);
const path = `/categories/${category}`;
const skills = skillsData.filter((skill) => skill.category === category);
const strings = ui[locale];
---

<BaseLayout locale={locale} path={path} {...seo}>
  <SiteHeader variant="detail" locale={locale} path={path} />
  <main id="main-content" class="px-6 py-10 sm:px-10 sm:py-14">
    <div class="mx-auto max-w-6xl">
      <nav aria-label="Breadcrumb" class="text-xs text-text-muted">
        <a href={localeHref(locale)} class="hover:text-text">{strings.skill.breadcrumbRoot}</a>
        <span class="mx-2">/</span>
        <span aria-current="page">{metadata.webTitle[locale]}</span>
      </nav>
      <p class="eyebrow mt-8 text-accent">Claude Code · Codex</p>
      <h1 class="mt-3 max-w-[28ch] text-[2rem] leading-[1.1] font-semibold tracking-[-0.03em] text-balance text-text sm:text-[2.75rem]">{metadata.webTitle[locale]}</h1>
      <p class="mt-4 max-w-[68ch] text-[15px] leading-7 text-text-secondary">{metadata.webDescription[locale]}</p>
      <p class="mt-4 font-mono text-xs text-text-muted">{strings.catalog.count(skills.length)}</p>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {skills.map((skill) => <SkillCard skill={skill} locale={locale} />)}
      </div>
      <nav aria-label={strings.header.categories} class="mt-12 border-t border-divider pt-6">
        <h2 class="text-sm font-semibold text-text">{strings.header.categories}</h2>
        <div class="mt-4 flex flex-wrap gap-2">
          <a href={localeHref(locale)} class="chip pressable">{strings.catalog.all}</a>
          {skillCategories.map((item) => (
            <a href={localeHref(locale, `/categories/${item}`)} class="chip pressable" aria-current={item === category ? "page" : undefined}>
              {categoryMetadata[item].webTitle[locale]}
            </a>
          ))}
        </div>
      </nav>
    </div>
  </main>
</BaseLayout>
