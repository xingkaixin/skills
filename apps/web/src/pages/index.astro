---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CopyCommand from "@/components/CopyCommand.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SkillCatalog from "@/components/SkillCatalog.astro";
import { skillCategories, skillsData } from "@/data/skills.generated";
import { getHomeSeo } from "@/data/seo";
import { faqItems } from "@/data/faq";

const seo = getHomeSeo();
const heroSub = `${skillsData.length} small, specific skills for Claude Code and any agent that reads SKILL.md. Filter by category, sort by what changed last, copy one install command.`;
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  canonicalUrl={seo.canonicalUrl}
  ogType={seo.ogType}
  structuredData={seo.structuredData}
  lang="en"
>
  <SiteHeader variant="home" />

  <main id="main-content">
    <section class="border-b border-divider px-6 pt-14 pb-10 sm:px-10">
      <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[1.15fr_1fr] lg:items-end">
        <div>
          <p class="eyebrow text-accent">Agent skills catalog</p>
          <h1 class="mt-3.5 max-w-[15ch] text-[2.25rem] leading-[1.12] font-semibold tracking-[-0.02em] text-balance sm:text-[2.75rem]">
            Focused expertise your agent loads on demand.
          </h1>
          <p class="mt-4.5 max-w-[46ch] text-[15px] leading-7 text-text-secondary">{heroSub}</p>
        </div>
        <div class="flex flex-col gap-3">
          <p class="text-xs text-text-secondary">Install the whole catalog</p>
          <CopyCommand command="npx skills add xingkaixin/skills" />
          <p class="font-mono text-xs text-text-muted">
            or add one: <span class="text-text-secondary">--skill &lt;slug&gt;</span>
          </p>
        </div>
      </div>
    </section>

    <SkillCatalog skills={skillsData} categories={skillCategories} />

    <section id="faq" aria-labelledby="faq-heading" class="px-6 pt-16 pb-20 sm:px-10">
      <div class="mx-auto max-w-6xl border-t border-divider pt-12">
        <h2 id="faq-heading" class="text-lg font-semibold text-text">FAQ</h2>
        <dl class="mt-6 grid gap-6 sm:grid-cols-2">
          {faqItems.map((item) => (
            <div>
              <dt class="text-sm font-medium text-text">{item.question}</dt>
              <dd class="mt-1.5 text-sm leading-7 text-text-secondary">{item.answer}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>
  </main>
</BaseLayout>
