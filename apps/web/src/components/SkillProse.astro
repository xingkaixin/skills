---
import type { Locale } from "@/i18n/config";
import { ui } from "@/i18n/ui";

interface Props {
  html: string;
  locale: Locale;
}

const { html, locale } = Astro.props;
const strings = ui[locale].copy;

function escapeAttr(value: string): string {
  return value.replace(/&/g, "&amp;").replace(/"/g, "&quot;").replace(/</g, "&lt;");
}

// Wrap fenced code blocks at build time so readers see the copy bar on first
// paint with zero layout shift and no runtime DOM rewrite.
const enhancedHtml = html.replace(
  /<pre><code(?: class="([^"]*)")?>([\s\S]*?)<\/code><\/pre>/g,
  (match, classAttr: string | undefined) => {
    const language = classAttr?.match(/language-([\w-]+)/)?.[1] ?? "code";
    return `<div class="code-block"><div class="code-block-bar"><span class="text-small text-ink-subtle">${escapeAttr(language)}</span><button type="button" class="copy-button pressable" data-copy-code data-copy-label="${escapeAttr(strings.action)}" data-copy-done="${escapeAttr(strings.done)}" data-copy-failed="${escapeAttr(strings.failed)}"><span data-copy-text>${escapeAttr(strings.action)}</span></button></div>${match}</div>`;
  },
);
---

<article class="skill-prose" set:html={enhancedHtml} />
