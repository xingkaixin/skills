---
import { SITE_NAME } from "@/data/catalog";
import { localeHref, type Locale } from "@/i18n/config";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<a
  href={localeHref(locale)}
  class="inline-flex items-center gap-2.5 rounded-md focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
>
  <img src="/favicon.svg" alt="" width="28" height="28" class="h-7 w-7 shrink-0" />
  <span class="text-sm font-semibold text-text">{SITE_NAME}</span>
</a>
