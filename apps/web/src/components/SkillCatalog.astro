---
import SkillCard from "@/components/SkillCard.astro";
import { categoryMetadata } from "@/data/catalog";
import SearchIcon from "@/components/SearchIcon.astro";
import type { SkillRecord } from "@/data/skill-record";
import { localeHref, type Locale } from "@/i18n/config";
import { ui } from "@/i18n/ui";

interface Props {
  skills: SkillRecord[];
  categories: string[];
  locale: Locale;
}

const { skills, categories, locale } = Astro.props;
const strings = ui[locale].catalog;
// Server render matches the default "recent" sort so the no-JS view is already ordered.
const ordered = [...skills].sort(
  (a, b) => b.lastModified.localeCompare(a.lastModified) || a.slug.localeCompare(b.slug),
);
const counts = new Map(
  categories.map((category) => [
    category,
    skills.filter((skill) => skill.category === category).length,
  ]),
);
const sortOptions = [
  { key: "recent", label: strings.sortRecent },
  { key: "az", label: strings.sortAlphabetical },
];
---

<div
  data-catalog
  data-count-one={strings.count(1)}
  data-count-many={strings.count(2)}
>
  <div class="z-20 flex flex-col gap-3 bg-white/90 py-3 backdrop-blur-md md:sticky md:top-[69px]">
    <div class="flex flex-wrap items-center gap-3">
      <form
        action={localeHref(locale)}
        method="get"
        role="search"
        class="flex min-h-12 flex-[1_1_20rem] items-center gap-2.5 rounded-xl border border-border bg-white px-3.5 transition-colors focus-within:border-text"
        data-catalog-search
      >
        <SearchIcon />
        <label class="sr-only" for="catalog-search">{ui[locale].header.searchSkills}</label>
        <input
          id="catalog-search"
          type="search"
          name="q"
          placeholder={strings.searchPlaceholder}
          data-search-focus
          class="w-full min-w-0 bg-transparent text-base text-text outline-none placeholder:text-text-muted sm:text-sm"
        />
        <kbd class="hidden rounded border border-border px-1.5 py-0.5 font-mono text-[10px] text-text-muted sm:block">⌘K</kbd>
      </form>
      <div class="seg-group" role="group" aria-label={strings.sortLabel}>
        {sortOptions.map((option, index) => (
          <button
            type="button"
            class="seg-button pressable"
            data-sort={option.key}
            aria-pressed={index === 0 ? "true" : "false"}
          >
            {option.label}
          </button>
        ))}
      </div>
    </div>
    <nav class="flex flex-wrap items-center gap-2" aria-label={strings.filterLabel}>
      <a href={localeHref(locale)} class="chip pressable" data-category="all" aria-current="page">
        {strings.all}<span class="chip-count">{skills.length}</span>
      </a>
      {categories.map((category) => (
        <a href={localeHref(locale, `/categories/${category}`)} class="chip pressable" data-category={category} title={categoryMetadata[category].webTitle[locale]}>
          {category}<span class="chip-count">{counts.get(category)}</span>
        </a>
      ))}
    </nav>
  </div>

  <p class="mt-3 text-[13px] text-text-muted" data-catalog-count aria-live="polite" aria-atomic="true">
    {strings.count(skills.length)}
  </p>

  <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-catalog-grid>
    {ordered.map((skill) => (
      <SkillCard skill={skill} locale={locale} />
    ))}
  </div>

  <p class="mt-4 rounded-xl border border-dashed border-border px-6 py-10 text-center text-sm text-text-secondary" data-catalog-empty hidden>
    {strings.empty}
  </p>
</div>

<script>
  import {
    CATALOG_SEARCH_EVENT,
    matchesSkillQuery,
    type CatalogSearchState,
  } from "@/data/skill-catalog";

  const root = document.querySelector<HTMLElement>("[data-catalog]");

  if (root) {
    const grid = root.querySelector<HTMLElement>("[data-catalog-grid]")!;
    const cards = Array.from(root.querySelectorAll<HTMLElement>("[data-skill]"));
    const chips = Array.from(root.querySelectorAll<HTMLAnchorElement>("a[data-category]"));
    const sorts = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-sort]"));
    const search = root.querySelector<HTMLInputElement>("#catalog-search")!;
    const form = root.querySelector<HTMLFormElement>("[data-catalog-search]")!;
    const countLabel = root.querySelector<HTMLElement>("[data-catalog-count]")!;
    const empty = root.querySelector<HTMLElement>("[data-catalog-empty]")!;
    const knownCategories = new Set(chips.map((chip) => chip.dataset.category));

    const params = new URLSearchParams(window.location.search);
    const initialCategory = params.get("category");
    const state: CatalogSearchState = {
      category: initialCategory && knownCategories.has(initialCategory) ? initialCategory : "all",
      query: params.get("q") ?? "",
      sort: "recent",
    };

    function setPressed(buttons: HTMLButtonElement[], key: string, value: string) {
      for (const button of buttons) {
        button.setAttribute("aria-pressed", button.dataset[key] === value ? "true" : "false");
      }
    }

    function reorder() {
      const byRecent = state.sort === "recent";
      const sorted = [...cards].sort((a, b) =>
        byRecent
          ? b.dataset.modified!.localeCompare(a.dataset.modified!) ||
            a.dataset.slug!.localeCompare(b.dataset.slug!)
          : a.dataset.slug!.localeCompare(b.dataset.slug!),
      );
      grid.append(...sorted);
    }

    function render(syncUrl: boolean) {
      const needle = state.query.trim().toLowerCase();
      let visible = 0;

      for (const card of cards) {
        const matches =
          (state.category === "all" || card.dataset.category === state.category) &&
          matchesSkillQuery(card.dataset.haystack!, needle);
        card.toggleAttribute("hidden", !matches);
        if (matches) visible += 1;
      }

      for (const chip of chips) {
        if (chip.dataset.category === state.category) chip.setAttribute("aria-current", "page");
        else chip.removeAttribute("aria-current");
      }
      setPressed(sorts, "sort", state.sort);
      // Two rendered samples stand in for the count function, which cannot
      // cross into the client bundle: swap the digit in whichever fits.
      const countTemplate =
        visible === 1 ? root!.dataset.countOne! : root!.dataset.countMany!;
      countLabel.textContent = countTemplate.replace(/\d+/, String(visible));
      empty.toggleAttribute("hidden", visible > 0);

      if (!syncUrl) return;

      const url = new URL(window.location.href);
      for (const [key, value] of [
        ["category", state.category === "all" ? "" : state.category],
        ["q", state.query],
      ] as const) {
        if (value) url.searchParams.set(key, value);
        else url.searchParams.delete(key);
      }
      window.history.replaceState({}, "", `${url.pathname}${url.search}`);
    }

    search.value = state.query;
    render(false);

    form.addEventListener("submit", (event) => event.preventDefault());
    search.addEventListener("input", () => {
      state.query = search.value;
      render(true);
    });

    for (const button of sorts) {
      button.addEventListener("click", () => {
        state.sort = button.dataset.sort === "az" ? "az" : "recent";
        reorder();
        render(true);
      });
    }

    document.addEventListener(CATALOG_SEARCH_EVENT, (event) => {
      const detail = (event as CustomEvent<Partial<CatalogSearchState>>).detail;
      if (
        typeof detail?.query !== "string" ||
        typeof detail.category !== "string" ||
        !knownCategories.has(detail.category) ||
        (detail.sort !== "recent" && detail.sort !== "az")
      ) {
        return;
      }

      state.query = detail.query;
      state.category = detail.category;
      state.sort = detail.sort;
      search.value = detail.query;
      reorder();
      render(true);
    });
  }
</script>
