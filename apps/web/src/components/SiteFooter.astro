---
import SiteBrand from "@/components/SiteBrand.astro";
import { categoryMetadata, MODS_REPO, SITE_REPO } from "@/data/catalog";
import { skillCategories } from "@/data/skills.generated";
import { LOCALES, localeHref, localeNames, localeTags, type Locale } from "@/i18n/config";
import { ui } from "@/i18n/ui";

interface Props {
  locale: Locale;
  /** Locale-free path, so the language links keep the reader on this page. */
  path: string;
}

const { locale, path } = Astro.props;
const strings = ui[locale];
const linkClass = "text-text-secondary transition-colors hover:text-text";
---

<footer class="border-t border-divider bg-surface px-6 sm:px-10">
  <div class="mx-auto flex max-w-6xl flex-wrap gap-10 pt-14 pb-10">
    <div class="min-w-0 flex-[2_1_18rem]">
      <SiteBrand locale={locale} />
      <p class="mt-4 max-w-[40ch] text-sm leading-7 text-text-secondary">{strings.footer.tagline}</p>
    </div>
    <nav aria-labelledby="footer-categories" class="flex-[1_1_16rem]">
      <h2 id="footer-categories" class="text-[13px] font-semibold text-text">{strings.header.categories}</h2>
      <ul class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2.5 text-sm">
        {skillCategories.map((category) => (
          <li>
            <a href={localeHref(locale, `/categories/${category}`)} class={linkClass}>
              {categoryMetadata[category].displayName.replace(/ Skills$/, "")}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <nav aria-labelledby="footer-project" class="flex-[1_1_11rem]">
      <h2 id="footer-project" class="text-[13px] font-semibold text-text">{strings.footer.project}</h2>
      <ul class="mt-4 flex flex-col gap-2.5 text-sm">
        <li><a href={SITE_REPO} class={linkClass}>{strings.footer.repository}</a></li>
        <li><a href={MODS_REPO} class={linkClass}>{strings.header.mods} ↗</a></li>
        <li><a href={`${SITE_REPO}/issues`} class={linkClass}>{strings.footer.issue}</a></li>
      </ul>
    </nav>
  </div>
  <div class="mx-auto flex max-w-6xl flex-wrap justify-between gap-4 border-t border-divider py-6 text-[13px] text-text-muted">
    <span>© {new Date().getFullYear()} XingKaiXin</span>
    <span class="flex gap-4">
      {LOCALES.map((option) => (
        <a
          href={localeHref(option, path)}
          hreflang={localeTags[option]}
          lang={localeTags[option]}
          aria-current={option === locale ? "true" : undefined}
          class="transition-colors hover:text-text aria-[current=true]:text-text"
        >
          {localeNames[option]}
        </a>
      ))}
    </span>
  </div>
</footer>
