---
import arrowRight from "lucide-static/icons/arrow-right.svg?raw";
import Icon from "@/components/Icon.astro";
import { skillSearchText } from "@/data/skill-catalog";
import { skillTitles } from "@/data/skill-titles";
import type { SkillRecord } from "@/data/skill-record";
import { localeHref, type Locale } from "@/i18n/config";
import { ui } from "@/i18n/ui";

interface Props {
  skill: SkillRecord;
  locale: Locale;
}

const { skill, locale } = Astro.props;
const strings = ui[locale].catalog;
---

<a
  href={localeHref(locale, `/skills/${skill.slug}`)}
  class="lm-card skill-card"
  data-sketch
  data-radius="8"
  data-skill
  data-category={skill.category}
  data-slug={skill.slug}
  data-modified={skill.lastModified}
  data-haystack={skillSearchText(skill)}
>
  <span class="flex items-center justify-between gap-2 text-small">
    <span class="text-accent">{skill.category}</span>
    <span class="text-ink-subtle">{strings.sourceKinds[skill.sourceKind]}</span>
  </span>
  <h3 class="mt-1 text-subheading text-ink">{skillTitles[skill.slug]?.[locale] ?? skill.slug}</h3>
  <p class="-mt-1.5 font-mono text-caption break-words text-ink-subtle">{skill.slug}</p>
  <p class="line-clamp-3 text-body text-ink-muted">{skill.displayDescription[locale]}</p>
  <span class="mt-auto flex items-center justify-between pt-2 text-small text-ink-subtle">
    <span>{strings.updated(skill.lastModified)}</span>
    <Icon svg={arrowRight} class="card-arrow h-4 w-4" />
  </span>
</a>
