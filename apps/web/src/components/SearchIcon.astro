---
import magnifyingGlass from "@phosphor-icons/core/regular/magnifying-glass.svg?no-inline";
import PhosphorIcon from "@/components/PhosphorIcon.astro";

interface Props {
  class?: string;
}

const { class: className = "h-[15px] w-[15px]" } = Astro.props;
---

<PhosphorIcon src={magnifyingGlass} class:list={["text-text-muted", className]} />
