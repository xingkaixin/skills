---
interface Props {
  class?: string;
}

const { class: className = "h-[15px] w-[15px]" } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  aria-hidden="true"
  class:list={["shrink-0 text-text-muted", className]}
>
  <circle cx="11" cy="11" r="7"></circle>
  <path d="M20 20l-3.2-3.2"></path>
</svg>
