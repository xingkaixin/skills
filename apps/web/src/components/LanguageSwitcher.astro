---
import chevronDown from "lucide-static/icons/chevron-down.svg?raw";
import Icon from "@/components/Icon.astro";
import { LOCALES, localeHref, localeNames, localeTags, type Locale } from "@/i18n/config";
import { ui } from "@/i18n/ui";

interface Props {
  locale: Locale;
  /** Locale-free path, so switching language keeps the reader on this page. */
  path: string;
}

const { locale, path } = Astro.props;
---

<details class="relative shrink-0" data-language-switcher>
  <summary
    aria-label={`${ui[locale].header.language}: ${localeNames[locale]}`}
    data-sketch
    data-wash
    class="lm-btn cursor-pointer list-none [&::-webkit-details-marker]:hidden"
  >
    <span lang={localeTags[locale]}>{localeNames[locale]}</span>
    <Icon svg={chevronDown} class="h-3 w-3" />
  </summary>
  <nav
    aria-label={ui[locale].header.language}
    data-sketch
    data-radius="8"
    class="absolute top-full right-0 z-20 mt-2 min-w-36 rounded-lg bg-surface p-1.5 shadow-overlay"
  >
    {LOCALES.map((option) => (
      <a
        href={localeHref(option, path)}
        hreflang={localeTags[option]}
        lang={localeTags[option]}
        class="flex min-h-11 items-center rounded-md px-3 text-small text-ink-muted hover:bg-surface-muted hover:text-ink aria-[current=true]:bg-surface-muted aria-[current=true]:text-ink"
        aria-current={option === locale ? "true" : undefined}
      >
        {localeNames[option]}
      </a>
    ))}
  </nav>
</details>

<script>
  const switcher = document.querySelector<HTMLDetailsElement>("[data-language-switcher]");

  if (switcher) {
    document.addEventListener("click", (event) => {
      if (event.target instanceof Node && !switcher.contains(event.target)) {
        switcher.open = false;
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || !switcher.open) return;

      switcher.open = false;
      switcher.querySelector("summary")?.focus();
    });
  }
</script>
