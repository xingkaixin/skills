---
interface Props {
  /** Raw Lucide SVG, imported with `?raw`. */
  svg: string;
  class?: string;
}

const { svg, class: className } = Astro.props;
// Strip license banner, XML namespace, redundant dimensions, and formatting.
const markup = svg
  .replace(/<!--.*?-->/gs, "")
  .replace(/\s+(?:xmlns|class|width|height|stroke-width)="[^"]*"/g, "")
  .replace(/\s+/g, " ")
  .replace(/>\s+</g, "><")
  .trim();
---

<span aria-hidden="true" class:list={["icon", className]} set:html={markup} />
