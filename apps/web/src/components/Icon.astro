---
interface Props {
  /** Raw Lucide SVG, imported with `?raw`. */
  svg: string;
  class?: string;
}

const { svg, class: className } = Astro.props;
// The license banner and source formatting would repeat on every card.
const markup = svg.replace(/<!--.*?-->|\n\s*/gs, " ").trim();
---

<span aria-hidden="true" class:list={["icon", className]} set:html={markup} />

<style>
  .icon {
    display: inline-flex;
    flex: none;
  }

  .icon :global(svg) {
    width: 100%;
    height: 100%;
    stroke-width: 1.5;
  }
</style>
