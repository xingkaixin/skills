---
import arrowUpRight from "lucide-static/icons/arrow-up-right.svg?raw";
import gitBranch from "lucide-static/icons/git-branch.svg?raw";
import Divider from "@/components/Divider.astro";
import Icon from "@/components/Icon.astro";
import SiteBrand from "@/components/SiteBrand.astro";
import SearchIcon from "@/components/SearchIcon.astro";
import LanguageSwitcher from "@/components/LanguageSwitcher.astro";
import { MODS_REPO, SITE_REPO } from "@/data/catalog";
import { localeHref, type Locale } from "@/i18n/config";
import { ui } from "@/i18n/ui";

interface Props {
  /** "home" links to the in-page sections; "detail" offers a search box back to the catalog. */
  variant?: "home" | "detail";
  locale: Locale;
  path: string;
}

const { variant = "home", locale, path } = Astro.props;
const strings = ui[locale];
const linkClass =
  "pressable min-h-11 items-center gap-1 whitespace-nowrap px-2.5 text-small text-ink-muted transition-colors hover:text-ink sm:px-3";
const homeLinks = [
  { href: "#skills", label: strings.header.skills },
  { href: "#categories", label: strings.header.categories },
  { href: "#faq", label: strings.header.faq },
];
---

<header class="sticky top-0 z-30 bg-paper/90 px-6 backdrop-blur-md sm:px-10">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-3 gap-y-1 py-3">
    <SiteBrand locale={locale} />
    {variant === "home" ? (
      <nav class="order-last -mx-2.5 flex w-full items-center md:order-none md:mx-0 md:ml-auto md:w-auto">
        {homeLinks.map((link) => (
          <a href={link.href} class:list={[linkClass, "inline-flex"]}>{link.label}</a>
        ))}
      </nav>
    ) : (
      <form
        action={localeHref(locale)}
        method="get"
        role="search"
        data-sketch
        class="order-last flex min-h-11 w-full min-w-0 items-center gap-2 px-3 md:order-none md:ml-auto md:w-64"
      >
        <SearchIcon />
        <label class="sr-only" for="header-search">{strings.header.searchSkills}</label>
        <input
          id="header-search"
          type="search"
          name="q"
          placeholder={strings.header.search}
          data-search-focus
          class="w-full min-w-0 bg-transparent text-base text-ink outline-none placeholder:text-ink-subtle md:text-small"
        />
        <kbd class="hidden font-mono text-caption text-ink-subtle md:block">⌘K</kbd>
      </form>
    )}
    <div class="ml-auto flex items-center gap-2 md:ml-0">
      <a href={MODS_REPO} class:list={[linkClass, "hidden sm:inline-flex"]}>
        {strings.header.mods}
        <Icon svg={arrowUpRight} class="h-3 w-3" />
      </a>
      <LanguageSwitcher locale={locale} path={path} />
      <a href={SITE_REPO} class="lm-btn pressable" data-sketch data-wash>
        <Icon svg={gitBranch} class="h-4 w-4" />
        <span class="sr-only sm:not-sr-only">{strings.header.repository}</span>
      </a>
    </div>
  </div>
  <Divider tone="strong" class="absolute inset-x-0 -bottom-1" />
</header>

<script>
  // ⌘K / Ctrl-K focuses whichever search field the current page renders.
  document.addEventListener("keydown", (event) => {
    if (event.key !== "k" || !(event.metaKey || event.ctrlKey)) return;

    const input = document.querySelector<HTMLInputElement>("[data-search-focus]");
    if (!input) return;

    event.preventDefault();
    input.focus();
    input.select();
  });
</script>
