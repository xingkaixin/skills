---
import SiteBrand from "@/components/SiteBrand.astro";
import SearchIcon from "@/components/SearchIcon.astro";
import LanguageSwitcher from "@/components/LanguageSwitcher.astro";
import { SITE_REPO } from "@/data/catalog";
import { localeHref, type Locale } from "@/i18n/config";
import { ui } from "@/i18n/ui";

interface Props {
  /** "home" links to the in-page sections; "detail" offers a search box back to the catalog. */
  variant?: "home" | "detail";
  locale: Locale;
  path: string;
}

const { variant = "home", locale, path } = Astro.props;
const strings = ui[locale];
const linkClass =
  "pressable inline-flex min-h-11 items-center whitespace-nowrap rounded-lg px-2 text-[13px] text-text-secondary transition hover:text-text sm:px-3";
const buttonClass =
  "pressable inline-flex min-h-11 items-center rounded-lg border border-border px-3 text-[13px] text-text transition hover:border-text";
---

<header class="border-b border-divider px-6 sm:px-10">
  <div class="mx-auto grid max-w-6xl grid-cols-[minmax(0,1fr)_auto] items-center gap-x-3 gap-y-2 py-3 md:flex md:justify-between md:gap-4">
    <SiteBrand locale={locale} />
    <div class="col-span-2 row-start-2 flex min-w-0 items-center justify-between gap-3 md:ml-auto">
      {variant === "home" ? (
        <nav class="flex items-center gap-1">
          <a href="#categories" class={linkClass}>{strings.header.categories}</a>
          <a href="#faq" class={linkClass}>{strings.header.faq}</a>
        </nav>
      ) : (
        <form
          action={localeHref(locale)}
          method="get"
          role="search"
          class="flex min-h-11 min-w-0 flex-1 items-center gap-2 rounded-lg border border-border px-3 py-2 transition focus-within:border-text md:w-60 md:flex-none"
        >
          <SearchIcon />
          <label class="sr-only" for="header-search">{strings.header.searchSkills}</label>
          <input
            id="header-search"
            type="search"
            name="q"
            placeholder={strings.header.search}
            data-search-focus
            class="w-full min-w-0 bg-transparent text-base text-text outline-none placeholder:text-text-muted md:text-[13px]"
          />
          <kbd class="hidden rounded border border-border px-1.5 py-0.5 font-mono text-[10px] text-text-muted md:block">⌘K</kbd>
        </form>
      )}
      <LanguageSwitcher locale={locale} path={path} />
    </div>
    <a href={SITE_REPO} class={buttonClass}>{strings.header.repository}</a>
  </div>
</header>

<script>
  // ⌘K / Ctrl-K focuses whichever search field the current page renders.
  document.addEventListener("keydown", (event) => {
    if (event.key !== "k" || !(event.metaKey || event.ctrlKey)) return;

    const input = document.querySelector<HTMLInputElement>("[data-search-focus]");
    if (!input) return;

    event.preventDefault();
    input.focus();
    input.select();
  });
</script>
