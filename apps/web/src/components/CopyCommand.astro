---
interface Props {
  command: string;
  tone?: "outline" | "solid";
  label?: string;
  class?: string;
}

const { command, tone = "outline", label = "Copy", class: className = "" } = Astro.props;
---

<div class:list={["command-box", className]}>
  <code class="truncate font-mono text-[13px] text-text">{command}</code>
  <button
    type="button"
    class="copy-button pressable"
    data-tone={tone}
    data-copy={command}
    data-copy-label={label}
  >
    {label}
  </button>
</div>

<script>
  const RESET_DELAY = 1400;

  document.addEventListener("click", (event) => {
    const button = (event.target as Element | null)?.closest<HTMLElement>("[data-copy]");
    if (!button) return;

    const text = button.getAttribute("data-copy") ?? "";
    void navigator.clipboard?.writeText(text);
    button.textContent = "Copied";
    window.setTimeout(() => {
      button.textContent = button.getAttribute("data-copy-label") ?? "Copy";
    }, RESET_DELAY);
  });
</script>
