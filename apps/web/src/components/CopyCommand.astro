---
import type { Locale } from "@/i18n/config";
import { ui } from "@/i18n/ui";

interface Props {
  command: string;
  locale: Locale;
  skill?: string;
  class?: string;
}

const { command, locale, skill, class: className = "" } = Astro.props;
const strings = ui[locale].copy;
---

<div class:list={["command-box", className]}>
  <code class="min-w-0 flex-1 whitespace-pre-wrap [overflow-wrap:anywhere] font-mono text-[13px] leading-6">{command}</code>
  <button
    type="button"
    class="copy-button pressable"
    data-copy={command}
    data-copy-label={strings.action}
    data-copy-done={strings.done}
    data-copy-failed={strings.failed}
    data-install-skill={skill ?? "all"}
    data-install-locale={locale}
  >
    {strings.action}
  </button>
</div>

<script>
  const RESET_DELAY = 1400;

  // Delegated so it also covers the copy buttons SkillProse builds at runtime.
  document.addEventListener("click", async (event) => {
    const button = (event.target as Element | null)?.closest<HTMLElement>("[data-copy]");
    if (!button) return;

    try {
      await navigator.clipboard.writeText(button.getAttribute("data-copy") ?? "");
    } catch {
      button.textContent = button.getAttribute("data-copy-failed") ?? button.getAttribute("data-copy-label");
      window.setTimeout(() => {
        button.textContent = button.getAttribute("data-copy-label");
      }, RESET_DELAY);
      return;
    }

    button.textContent = button.getAttribute("data-copy-done");
    window.setTimeout(() => {
      button.textContent = button.getAttribute("data-copy-label");
    }, RESET_DELAY);

    const skill = button.dataset.installSkill;
    if (skill) {
      void window.umami?.track("install-command-copy", {
        skill,
        scope: skill === "all" ? "all" : "skill",
        locale: button.dataset.installLocale ?? "en",
      });
    }
  });
</script>
