---
import type { Locale } from "@/i18n/config";
import { ui } from "@/i18n/ui";

interface Props {
  command: string;
  locale: Locale;
  tone?: "outline" | "solid";
  class?: string;
}

const { command, locale, tone = "outline", class: className = "" } = Astro.props;
const strings = ui[locale].copy;
---

<div class:list={["command-box", className]}>
  <code class="min-w-0 whitespace-pre-wrap [overflow-wrap:anywhere] font-mono text-[13px] text-text">{command}</code>
  <button
    type="button"
    class="copy-button pressable"
    data-tone={tone}
    data-copy={command}
    data-copy-label={strings.action}
    data-copy-done={strings.done}
  >
    {strings.action}
  </button>
</div>

<script>
  const RESET_DELAY = 1400;

  // Delegated so it also covers the copy buttons SkillProse builds at runtime.
  document.addEventListener("click", (event) => {
    const button = (event.target as Element | null)?.closest<HTMLElement>("[data-copy]");
    if (!button) return;

    void navigator.clipboard?.writeText(button.getAttribute("data-copy") ?? "");
    button.textContent = button.getAttribute("data-copy-done");
    window.setTimeout(() => {
      button.textContent = button.getAttribute("data-copy-label");
    }, RESET_DELAY);
  });
</script>
