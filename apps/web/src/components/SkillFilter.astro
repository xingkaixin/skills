---
import type { SkillRecord } from "@/data/skill-record";

interface Props {
  skills: SkillRecord[];
  categories: string[];
}

const { skills, categories } = Astro.props;
const chipBase = "pressable inline-flex min-h-11 shrink-0 items-center rounded-full border px-3 py-1 text-xs uppercase tracking-[0.16em] transition";
const chipActive = "border-text bg-text text-white";
const chipInactive = "border-border bg-transparent text-text-secondary hover:border-text hover:text-text";
---

<div data-skill-filter>
  <div
    class="-mx-6 mb-6 flex flex-nowrap items-center gap-2 overflow-x-auto border-b border-border bg-bg px-6 py-3 sm:sticky sm:top-0 sm:z-10 sm:flex-wrap"
    aria-label="Skill categories"
  >
    <button
      type="button"
      class={`${chipBase} ${chipActive}`}
      data-category="all"
      aria-pressed="true"
    >
      All
    </button>
    {categories.map((category) => (
      <button
        type="button"
        class={`${chipBase} ${chipInactive}`}
        data-category={category}
        aria-pressed="false"
      >
        {category}
      </button>
    ))}
    <span
      class="ml-auto shrink-0 text-xs text-text-muted"
      data-skill-count
      aria-live="polite"
      aria-atomic="true"
    >
      {skills.length} skills
    </span>
  </div>

  <div class="divide-y divide-border">
    {skills.map((skill) => (
      <a
        href={`/skills/${skill.slug}`}
        class="group flex min-h-11 flex-col items-start gap-1 px-1 py-4 transition-colors hover:bg-accent-soft sm:flex-row sm:items-baseline sm:gap-6 sm:py-3"
        data-skill-item
        data-category={skill.category}
      >
        <span class="max-w-full shrink-0 truncate text-sm font-medium text-text sm:w-44">
          {skill.slug}
        </span>
        <span class="line-clamp-2 min-w-0 flex-1 text-sm leading-6 text-text-secondary sm:line-clamp-1">
          {skill.description}
        </span>
        <span
          aria-hidden="true"
          class="hidden shrink-0 text-xs text-text-muted opacity-0 transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100 sm:block"
        >
          →
        </span>
      </a>
    ))}
  </div>
</div>

<script>
  const root = document.querySelector("[data-skill-filter]");

  if (root instanceof HTMLElement) {
    const buttons = Array.from(
      root.querySelectorAll<HTMLButtonElement>("button[data-category]"),
    );
    const items = Array.from(
      root.querySelectorAll<HTMLElement>("[data-skill-item]"),
    );
    const count = root.querySelector("[data-skill-count]");
    const knownCategories = new Set(
      buttons.map((button) => button.getAttribute("data-category")),
    );
    const activeClasses = ["border-text", "bg-text", "text-white"];
    const inactiveClasses = [
      "border-border",
      "bg-transparent",
      "text-text-secondary",
      "hover:border-text",
      "hover:text-text",
    ];

    function setButtonState(button: HTMLButtonElement, isActive: boolean) {
      button.classList.remove(...activeClasses, ...inactiveClasses);
      button.classList.add(...(isActive ? activeClasses : inactiveClasses));
      button.setAttribute("aria-pressed", isActive ? "true" : "false");
    }

    function applyFilter(category: string, updateUrl: boolean) {
      let visibleCount = 0;

      for (const item of items) {
        const isVisible =
          category === "all" || item.getAttribute("data-category") === category;
        item.toggleAttribute("hidden", !isVisible);
        if (isVisible) visibleCount += 1;
      }

      for (const button of buttons) {
        setButtonState(button, button.getAttribute("data-category") === category);
      }

      if (count) {
        count.textContent = `${visibleCount} ${visibleCount === 1 ? "skill" : "skills"}`;
      }

      if (updateUrl) {
        const url = new URL(window.location.href);
        if (category === "all") {
          url.searchParams.delete("category");
        } else {
          url.searchParams.set("category", category);
        }
        window.history.replaceState({}, "", `${url.pathname}${url.search}${url.hash}`);
      }
    }

    const initialCategory = new URLSearchParams(window.location.search).get("category");
    applyFilter(
      initialCategory && knownCategories.has(initialCategory) ? initialCategory : "all",
      false,
    );

    for (const button of buttons) {
      button.addEventListener("click", () => {
        applyFilter(button.getAttribute("data-category") ?? "all", true);
      });
    }
  }
</script>
