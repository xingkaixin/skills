---
interface Props {
  src: string;
  class?: string;
}

const { src, class: className } = Astro.props;
---

<span
  aria-hidden="true"
  class:list={["phosphor-icon", className]}
  style={`--phosphor-icon-source: url("${src}")`}
></span>

<style>
  .phosphor-icon {
    display: inline-block;
    flex: none;
    background: currentColor;
    mask: var(--phosphor-icon-source) center / contain no-repeat;
  }
</style>
